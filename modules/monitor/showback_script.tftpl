/**
 * Get an array of auth domains for the organization.
 * @returns an array of auth domains.
 */
async function getAuthDomainsArray() {
  const body = {
    query: `
      query ($authDomainCursor: String) {
        actor {
          organization {
            authorizationManagement {
              authenticationDomains(cursor: $authDomainCursor) {
                authenticationDomains {
                  id
                  name
                }
                nextCursor
              }
            }
          }
        }
      }
    `,
    variables: {
      "authDomainCursor": null
    }
  }
  const options = {
    url: nerdGraphEndpoint,
    headers: {
      'API-key': $secure.SHOWBACK_QUERY_USER_API_KEY,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(body),
    retry: { // By default, Got does not retry on POST
      limit: MAX_RETRIES,
      methods: ['POST']
    }
  };

  try {
    let authDomains = [];
    do {
      console.debug('getAuthDomainsArray()postWithRetries');
      let response = await postWithRetries(options);
      let responseBody = JSON.parse(response.body);
      if (responseBody.hasOwnProperty('errors')) {
        console.error(responseBody.errors);
      }
      authDomains = authDomains.concat(responseBody.data.actor.organization.authorizationManagement.authenticationDomains.authenticationDomains);
      body.variables.authDomainCursor = responseBody.data.actor.organization.authorizationManagement.authenticationDomains.nextCursor;
      options.body = JSON.stringify(body);
    } while (body.variables.authDomainCursor)
    return authDomains;
  } catch (error) {
    console.error('getAuthDomainsArray():', error);
  }
}


/**
 * Wrap $http.post with a configurable number of retries.
 * @param {*} options the post options.
 * @returns the response.
 */
async function postWithRetries(options) {
  let success = false;
  let response;
  let retries = 0;
  let currentError;
  do {
    try {
      response = await $http.post(options);
      let responseBody = JSON.parse(response.body);
      if (responseBody.hasOwnProperty('errors')) {
        console.error("postWithRetries(): API error (retry " + retries + "/" + MAX_RETRIES + "):", JSON.stringify(responseBody.errors).substring(0, 200));
        currentError = responseBody.errors;
        retries++;
      } else {
        success = true;
      }
    } catch (error) {
      console.error("postWithRetries(): request error (retry " + retries + "/" + MAX_RETRIES + "):", error.code || error.message);
      currentError = error;
      retries++;
    }
  } while (!success && retries <= MAX_RETRIES);
  if (success) {
    return response;
  } else {
    console.error("postWithRetries(): max retries exceeded:", MAX_RETRIES);
    throw currentError;
  }
}


/**
 * Fetch all users with full details (type, lastActive) AND group memberships in a single query per auth domain.
 * Replaces: getGroupIdToGroupAndUsersMap, getGroupUsersByCursor, enrichEmailToUserAndGroupsMap, buildEmailToUserAndGroupsMap.
 * Processes auth domains sequentially to keep peak memory to one domain's data at a time.
 * @param {*} authDomainsArray an array of auth domains.
 * @returns {Object} { enrichedEmailToUserAndGroupsMap, consolidatedEmailToUserAndGroupsMap, allGroupIds }
 */
async function getAllUsersWithGroups(authDomainsArray) {
  const body = {
    query: `
      query ($authDomainId: [ID!], $usersCursor: String) {
        actor {
          organization {
            userManagement {
              authenticationDomains(id: $authDomainId) {
                authenticationDomains {
                  users(cursor: $usersCursor) {
                    nextCursor
                    users {
                      email
                      id
                      lastActive
                      name
                      timeZone
                      type { id, displayName }
                      groups {
                        groups { id, displayName }
                        nextCursor
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    `,
    variables: { "authDomainId": null, "usersCursor": null }
  };
  const options = {
    url: nerdGraphEndpoint,
    headers: { 'Api-Key': $secure.SHOWBACK_QUERY_USER_API_KEY, 'Content-Type': 'application/json' },
    body: null,
    retry: { limit: MAX_RETRIES, methods: ['POST'] }
  };

  let enrichedEmailToUserAndGroupsMap = new Map();
  let consolidatedEmailToUserAndGroupsMap = new Map();
  let allGroupIds = new Set();

  // Process each auth domain sequentially
  for (const authDomain of authDomainsArray) {
    body.variables.authDomainId = authDomain.id;
    body.variables.usersCursor = null;
    options.body = JSON.stringify(body);

    do {
      let response = await postWithRetries(options);
      let responseBody = JSON.parse(response.body);
      if (responseBody.hasOwnProperty('errors')) {
        console.error(responseBody.errors);
      }
      let users = responseBody.data.actor.organization.userManagement.authenticationDomains.authenticationDomains[0].users.users;

      for (const user of users) {
        // Collect all group IDs for Phase 3 (group-role fetching)
        if (user.groups?.groups) {
          for (const group of user.groups.groups) {
            allGroupIds.add(group.id);
          }
        }

        // Build enriched map (case-sensitive email)
        if (user.email) {
          let existingUser = enrichedEmailToUserAndGroupsMap.get(user.email);
          if (existingUser) {
            // Merge groups from this auth domain
            if (user.groups?.groups && existingUser.groups?.groups) {
              for (const g of user.groups.groups) {
                if (!existingUser.groups.groups.some(eg => eg.id === g.id)) {
                  existingUser.groups.groups.push(g);
                }
              }
            }
          } else {
            // Normalize groups structure to match downstream expectations
            user.groups = user.groups || { groups: [] };
            user.groups.groups = user.groups.groups || [];
            enrichedEmailToUserAndGroupsMap.set(user.email, user);
          }
        }

        // Build consolidated map (case-insensitive email)
        let caseInsensitiveEmail = user.email?.toLowerCase();
        if (consolidatedEmailToUserAndGroupsMap.has(caseInsensitiveEmail)) {
          let consolidatedUser = consolidatedEmailToUserAndGroupsMap.get(caseInsensitiveEmail);
          consolidatedUser.email = caseInsensitiveEmail;
          // Consolidate user type (Full > Core > Basic)
          if (consolidatedUser.type.displayName == 'Basic' && user.type.displayName == 'Core') {
            consolidatedUser.type = user.type;
            consolidatedUser.id = user.id;
            consolidatedUser.name = user.name;
            consolidatedUser.timeZone = user.timeZone;
          } else if ((consolidatedUser.type.displayName == 'Basic' || consolidatedUser.type.displayName == 'Core') && user.type.displayName == 'Full platform') {
            consolidatedUser.type = user.type;
            consolidatedUser.id = user.id;
            consolidatedUser.name = user.name;
            consolidatedUser.timeZone = user.timeZone;
          }
          // Consolidate lastActive
          if (user.lastActive) {
            if (consolidatedUser.lastActive) {
              if (new Date(user.lastActive).getTime() >= new Date(consolidatedUser.lastActive).getTime()) {
                consolidatedUser.lastActive = user.lastActive;
              }
            } else {
              consolidatedUser.lastActive = user.lastActive;
            }
          }
          // Consolidate groups
          if (user.groups?.groups) {
            consolidatedUser.groups = consolidatedUser.groups || { groups: [] };
            consolidatedUser.groups.groups = consolidatedUser.groups.groups || [];
            for (const g of user.groups.groups) {
              if (!consolidatedUser.groups.groups.some(eg => eg.id === g.id)) {
                consolidatedUser.groups.groups.push(g);
              }
            }
          }
        } else if (caseInsensitiveEmail) {
          user.groups = user.groups || { groups: [] };
          user.groups.groups = user.groups.groups || [];
          consolidatedEmailToUserAndGroupsMap.set(caseInsensitiveEmail, user);
        }
      }

      body.variables.usersCursor = responseBody.data.actor.organization.userManagement.authenticationDomains.authenticationDomains[0].users.nextCursor;
      options.body = JSON.stringify(body);
    } while (body.variables.usersCursor);
  }

  return { enrichedEmailToUserAndGroupsMap, consolidatedEmailToUserAndGroupsMap, allGroupIds };
}


/**
 * Fetch group-to-role mappings using batched group IDs (all at once per auth domain).
 * Replaces: getAuthDomainToGroupsMap, getGroupIdToRolesMap, getGroupIdAndRolesObject, getGroupIdAndRolesObjectWithRetries.
 * @param {*} authDomainsArray an array of auth domains.
 * @param {*} allGroupIds a Set of all group IDs that need role lookups.
 * @returns a map of group IDs to their roles arrays.
 */
async function getBatchedGroupRoles(authDomainsArray, allGroupIds) {
  const body = {
    query: `
      query ($authDomainId: [ID!], $groupIds: [ID!], $groupsCursor: String) {
        actor {
          organization {
            authorizationManagement {
              authenticationDomains(id: $authDomainId) {
                authenticationDomains {
                  groups(id: $groupIds, cursor: $groupsCursor) {
                    groups {
                      id
                      displayName
                      roles {
                        roles {
                          accountId
                          type
                          roleId
                          organizationId
                          name
                          id
                          displayName
                        }
                        nextCursor
                      }
                    }
                    nextCursor
                  }
                }
              }
            }
          }
        }
      }
    `,
    variables: { "authDomainId": null, "groupIds": null, "groupsCursor": null }
  };
  const options = {
    url: nerdGraphEndpoint,
    headers: { 'Api-Key': $secure.SHOWBACK_QUERY_USER_API_KEY, 'Content-Type': 'application/json' },
    body: null,
    retry: { limit: MAX_RETRIES, methods: ['POST'] }
  };

  let groupIdToRolesMap = new Map();
  let groupIdsArray = Array.from(allGroupIds);
  let apiCallCount = 0;
  let rolePaginationCount = 0;

  // Process each auth domain sequentially
  for (const authDomain of authDomainsArray) {
    let domainPageCount = 0;
    body.variables.authDomainId = authDomain.id;
    body.variables.groupIds = groupIdsArray;
    body.variables.groupsCursor = null;
    options.body = JSON.stringify(body);

    // Paginate through groups in the response
    do {
      apiCallCount++;
      domainPageCount++;
      let response = await postWithRetries(options);
      let responseBody = JSON.parse(response.body);
      if (responseBody.hasOwnProperty('errors')) {
        console.error(responseBody.errors);
      }
      let authDomains = responseBody.data.actor.organization.authorizationManagement.authenticationDomains.authenticationDomains;
      if (!authDomains || authDomains.length === 0) break;

      let groupsData = authDomains[0].groups;
      if (domainPageCount <= 3 || !groupsData.nextCursor) {
        console.debug('[TIMING] getBatchedGroupRoles: page ' + domainPageCount + ' returned ' + groupsData.groups.length + ' groups, nextCursor=' + (groupsData.nextCursor ? 'yes' : 'null'));
      }
      for (const group of groupsData.groups) {
        let roles = group.roles?.roles || [];

        // Handle role pagination for groups with many roles
        if (group.roles?.nextCursor) {
          rolePaginationCount++;
          roles = await paginateGroupRoles(authDomain.id, group.id, roles, group.roles.nextCursor);
        }

        // Merge roles if group was already seen in another auth domain
        if (groupIdToRolesMap.has(group.id)) {
          let existing = groupIdToRolesMap.get(group.id);
          groupIdToRolesMap.set(group.id, existing.concat(roles));
        } else {
          groupIdToRolesMap.set(group.id, roles);
        }
      }

      body.variables.groupsCursor = groupsData.nextCursor;
      options.body = JSON.stringify(body);
    } while (body.variables.groupsCursor);
    console.debug('[TIMING] getBatchedGroupRoles: domain ' + authDomain.name + ': ' + domainPageCount + ' pages, ' + groupIdToRolesMap.size + ' groups mapped so far (requested ' + groupIdsArray.length + ' IDs)');
  }
  console.debug('[TIMING] getBatchedGroupRoles: ' + apiCallCount + ' API calls + ' + rolePaginationCount + ' role pagination calls');

  return groupIdToRolesMap;
}


/**
 * Paginate through remaining roles for a specific group.
 * @param {*} authDomainId the auth domain ID.
 * @param {*} groupId the group ID.
 * @param {*} existingRoles roles already fetched.
 * @param {*} cursor the roles nextCursor.
 * @returns the complete roles array.
 */
async function paginateGroupRoles(authDomainId, groupId, existingRoles, cursor) {
  const body = {
    query: `
      query ($authDomainId: [ID!], $groupId: [ID!], $rolesCursor: String) {
        actor {
          organization {
            authorizationManagement {
              authenticationDomains(id: $authDomainId) {
                authenticationDomains {
                  groups(id: $groupId) {
                    groups {
                      roles(cursor: $rolesCursor) {
                        roles {
                          accountId
                          type
                          roleId
                          organizationId
                          name
                          id
                          displayName
                        }
                        nextCursor
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    `,
    variables: { "authDomainId": authDomainId, "groupId": groupId, "rolesCursor": cursor }
  };
  const options = {
    url: nerdGraphEndpoint,
    headers: { 'Api-Key': $secure.SHOWBACK_QUERY_USER_API_KEY, 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
    retry: { limit: MAX_RETRIES, methods: ['POST'] }
  };

  let roles = existingRoles;
  do {
    let response = await postWithRetries(options);
    let responseBody = JSON.parse(response.body);
    if (responseBody.hasOwnProperty('errors')) {
      console.error(responseBody.errors);
    }
    let groupData = responseBody.data.actor.organization.authorizationManagement.authenticationDomains.authenticationDomains[0].groups.groups[0];
    roles = roles.concat(groupData.roles.roles);
    body.variables.rolesCursor = groupData.roles.nextCursor;
    options.body = JSON.stringify(body);
  } while (body.variables.rolesCursor);

  return roles;
}


/**
 * The scripts main function and starting point.
 */
async function main() {
  let response = await processShowback();

  console.log('main(): Script execution completed');
}


// Let's get this party started
main();
