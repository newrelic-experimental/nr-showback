            "nrqlQueries": [
              {
                "accountId": ${tf_account_id},
                "query": "FROM NrConsumption SELECT sum(consumption) OR 0 AS 'Total aCCU', if(${tf_min_accu} = 0, sum(consumption) OR 0, if((SELECT sum(consumption) FROM NrConsumption WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month) > ${tf_min_accu}, (sum(consumption) OR 0) / ((SELECT sum(consumption) FROM NrConsumption WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month) OR 1) * (((SELECT sum(consumption) FROM NrConsumption WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month) OR 0) - ${tf_min_accu}), 0)) AS 'Billable aCCU', if(${tf_min_accu} = 0, (sum(consumption) OR 0) * ${tf_accu_unit_usd}, ((sum(consumption) OR 0) / ((SELECT sum(consumption) FROM NrConsumption WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month) OR 1) * if((SELECT sum(consumption) FROM NrConsumption WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month) > ${tf_min_accu}, ${tf_min_accu} * ${tf_accu_committed_usd} + (((SELECT sum(consumption) FROM NrConsumption WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month) OR 0) - ${tf_min_accu}) * ${tf_accu_additional_usd}, ${tf_min_accu} * ${tf_accu_committed_usd}))) AS 'aCCU Cost (USD)' WHERE metric IN ('AdvancedCCU') AND dimension_productFeature != 'Cloud bytes received' AND consumingAccountName IS NOT NULL SINCE this month FACET CASES(%{ for index_department, department in tf_showback_config ~}WHERE consumingAccountName IN (%{ for index_accounts_in, account in department.accounts_in }%{ if index_accounts_in != 0 ~}, %{ endif }'${account}'%{ endfor ~})%{ for regex in department.accounts_regex } OR consumingAccountName RLIKE r'${regex}'%{ endfor } AS '${department.department_name}', %{ endfor ~}WHERE consumingAccountName IS NOT NULL AS 'Unassigned') AS 'department'"
              }
